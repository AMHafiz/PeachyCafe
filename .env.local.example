# Copy this file to .env.local and fill in real values.

# Resend (https://resend.com) -- used by src/app/api/contact/route.ts to email
# contact/order form submissions.
RESEND_API_KEY=

# Where form submissions and paid Clover order alerts get sent (the store's
# inbox) -- see src/app/api/contact/route.ts and src/app/api/clover/confirm/route.ts.
STORE_NOTIFICATION_EMAIL=

# A long random string used to encrypt order details that ride through the
# Clover checkout success redirect (src/lib/orderConfirmationToken.ts).
# Generate with: openssl rand -hex 32
ORDER_CONFIRMATION_SECRET=

# Clover Hosted Checkout (src/app/api/clover/checkout/route.ts). Get these
# from the Clover Sandbox dashboard for the app/merchant under test:
# https://sandbox.dev.clover.com
CLOVER_MERCHANT_ID=
# The Ecommerce API "private token" for that merchant -- sent as
# `Authorization: Bearer $CLOVER_PRIVATE_KEY`. Not the same as a Clover PAK.
CLOVER_PRIVATE_KEY=
# "production" switches the API host to https://api.clover.com; anything
# else (including unset, e.g. local dev) uses the sandbox host
# https://apisandbox.dev.clover.com.
CLOVER_ENVIRONMENT=sandbox
