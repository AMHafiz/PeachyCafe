# Copy this file to .env.local and fill in real values.

# Resend (https://resend.com) -- used by src/app/api/contact/route.ts to email
# contact/order form submissions.
RESEND_API_KEY=

# Where form submissions get sent (the store's inbox).
STORE_NOTIFICATION_EMAIL=

# Where paid Clover order notifications get sent (the kitchen's inbox) -- see
# src/app/api/clover/confirm/route.ts.
BAKERY_NOTIFICATION_EMAIL=

# A long random string used to encrypt order details that ride through the
# Clover checkout success redirect (src/lib/orderConfirmationToken.ts).
# Generate with: openssl rand -hex 32
ORDER_CONFIRMATION_SECRET=
